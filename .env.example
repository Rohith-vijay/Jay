# Copy this file to .env and fill in what you need. Only one brain is required.

# ---- Brains (API keys) -------------------------------------------------------
# Free:  Google Gemini  - key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free:  Groq           - key from https://console.groq.com/keys
GROQ_API_KEY=
# Free models: OpenRouter - key from https://openrouter.ai/keys (also set JARVIS_OPENROUTER_MODEL)
OPENROUTER_API_KEY=
# Paid:  Claude         - key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Which brain to start on, and the order to fall back through when one is
# unavailable (no key, rate limit, offline). Names: gemini, groq, openrouter, claude, ollama
JARVIS_PROVIDER=gemini
JARVIS_FALLBACK_ORDER=gemini,groq,claude,ollama

# ---- Models ------------------------------------------------------------------
# Several models can be listed; when one model's free quota runs out the next is used.
JARVIS_GEMINI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
JARVIS_GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
JARVIS_OPENROUTER_MODEL=
JARVIS_CLAUDE_MODEL=claude-opus-5-5
# Claude thinking effort: low (fastest, cheapest) | medium | high | xhigh | max
JARVIS_EFFORT=medium
# Local model served by Ollama (must support tool calling)
JARVIS_OLLAMA_MODEL=qwen3:8b

# How many past turns are resent to the free/local brains. Lower = fewer tokens.
JARVIS_HISTORY_TURNS=12

# ---- Voice -------------------------------------------------------------------
JARVIS_NAME=Jay
# Other spellings the wake word may be heard as, comma separated
JARVIS_WAKE_ALIASES=jai,jey,jae,jaye,j,jaya,jake,jade,jaay,jah
# 1 = any voice can wake Jay; 0 = only voices set up under Voices (once there are any)
JARVIS_WAKE_ANYONE=0
# Languages you speak to it: en (English only) or en,te (English and Telugu)
JARVIS_LANGUAGES=en
# After a reply, seconds it keeps listening for a follow-up without "Hey Jay"
JARVIS_ACTIVE_SECONDS=25
# Small model on this laptop that spots "Hey Jay" and "Stop Jay"
JARVIS_WAKE_MODEL=base.en
# Minutes between unprompted schedule reviews; 0 turns them off
JARVIS_CHECKIN_MINUTES=45
# Greet and brief on the first start of each day (1 = on, 0 = off)
JARVIS_MORNING_BRIEF=1

# Speech in: auto (Groq's Whisper when GROQ_API_KEY is set, else local) | groq | local
JARVIS_STT=auto
JARVIS_STT_MODEL=whisper-large-v3
# Local speech model, used when Groq isn't: tiny, base, small, medium (bigger = better Telugu, slower)
JARVIS_WHISPER_MODEL=small
# Speech out: auto (online neural voices, falling back to the Windows voice) | edge | sapi
JARVIS_TTS=auto
# Voice: refined British male by default. Others: en-GB-ThomasNeural, en-US-BrianMultilingualNeural,
# en-US-AndrewMultilingualNeural
JARVIS_VOICE_EN=en-GB-RyanNeural
JARVIS_VOICE_RATE=+4%
JARVIS_VOICE_PITCH=-3Hz
# How Jay addresses you, e.g. sir, boss, or your first name. Leave empty for neither.
JARVIS_ADDRESS=
JARVIS_VOICE_TE=te-IN-MohanNeural
JARVIS_TTS_RATE=185
# Microphone loudness needed to count as speech. 0 = measure the room at startup.
JARVIS_MIC_THRESHOLD=0

# ---- Extras ------------------------------------------------------------------
# End-of-day summary time, 24-hour HH:MM. Empty turns it off.
JARVIS_NIGHT_TIME=22:30
# A shortcut that summons Jay from any app. Empty turns it off.
JARVIS_HOTKEY=ctrl+alt+j
# Phone access: create a bot with @BotFather on Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=

# ---- Phone, mail and calendar --------------------------------------------------
# Telegram bot for two-way chat with Jay (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Phone alerts via the free ntfy app: leave empty and say "set up phone alerts" (Jay creates the topic)
NTFY_TOPIC=
# Email over IMAP/SMTP with an app password (Gmail: Security -> 2-Step Verification -> App passwords)
JARVIS_MAIL_USER=
JARVIS_MAIL_PASSWORD=
# Only for non-Gmail/Outlook providers:
JARVIS_MAIL_IMAP=
JARVIS_MAIL_SMTP=
# Secret iCal address(es) of your calendar(s) or timetable, comma separated
JARVIS_ICS_URLS=

# ---- Rhythm: when Jay speaks up ---------------------------------------------------
# digest = planned blocks only show up in a morning and an evening summary (sent when you are at the laptop);
# each = a reminder at every block's start time
JARVIS_REMINDER_MODE=digest
# The evening summary starts from this time on a college/busy day, and from the second time on other days
JARVIS_EVENING_AFTER=19:30
JARVIS_EVENING_OTHER=17:30
# Read the morning and evening summaries aloud when you are at the laptop (1/0)
JARVIS_DIGEST_SPEAK=1
# A spoken addition within this many seconds joins the request still being processed
JARVIS_MERGE_SECONDS=12
# Public usernames, so Jay can check a LeetCode / coding block was really done (no passwords needed)
JARVIS_LEETCODE_USER=
JARVIS_GITHUB_USER=
# Extra words the speech recogniser should expect (names, courses, tools), comma separated
JARVIS_STT_VOCAB=
# Weekly summary time on Sundays; fixed-time morning plan used only when JARVIS_REMINDER_MODE=each
JARVIS_WEEKLY_TIME=20:00
JARVIS_BRIEF_TIME=07:00
